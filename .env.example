APP_ENV=local
APP_TIMEZONE=Asia/Baku
DEFAULT_LANGUAGE=en
POSTGRES_DB=rental
POSTGRES_USER=rental_owner
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rental
DB_USER=rental_app
CHECKPOINT_DB_USER=rental_graph
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
APP_DATABASE_PASSWORD_FILE=/run/secrets/app_database_password
GRAPH_DATABASE_PASSWORD_FILE=/run/secrets/graph_database_password
REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_HOST=redis
INTERNAL_API_URL=http://api:8000
APP_ORIGIN=http://localhost:3000
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
QUOTE_SIGNING_KEY_FILE=/run/secrets/quote_signing_key
CHAT_CONTEXT_MAX_TURNS=10
CHAT_CONTEXT_MAX_TOKENS=6000
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
AI_MAX_CONCURRENCY=4
OPENAI_RPM_LIMIT=30
OPENAI_TPM_LIMIT=60000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY_FILE=/run/secrets/langsmith_api_key
LANGSMITH_PROJECT=yol-rental-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Keep customer prompts and model responses out of external traces by default.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
QUOTE_TTL_SECONDS=600
HOLD_TTL_SECONDS=600
FX_REFRESH_SECONDS=21600
CHAT_RETENTION_MONTHS=12
ASSET_PROVIDER=filesystem
ASSET_ROOT=/data/assets
NOTIFICATION_PROVIDER=in_app
COOKIE_SECURE=false
